#!/usr/bin/env bash
cmd="$(basename "$0")"
case "$cmd" in
  python|python3|python3.14)
    echo '⚠️ USER INSTRUCTION: Direct Python execution is prohibited in @wsl2. Use uv with Python 3.14: uv run --python 3.14 python ...' >&2
    ;;
  pip|pip3|pip3.14)
    echo '⚠️ USER INSTRUCTION: Direct pip execution is prohibited in @wsl2. Use uv: prefer uv add <package>, or uv pip ... when pip-compatible behavior is required.' >&2
    ;;
  npm)
    echo '⚠️ USER INSTRUCTION: npm is prohibited in @wsl2. Use pnpm instead.' >&2
    ;;
  npx)
    echo '⚠️ USER INSTRUCTION: npx is prohibited in @wsl2. Use pnpm dlx instead.' >&2
    ;;
  yarn|yarnpkg)
    echo '⚠️ USER INSTRUCTION: yarn is prohibited in @wsl2. Use pnpm instead.' >&2
    ;;
  *)
    echo "⚠️ USER INSTRUCTION: Direct '$cmd' execution is prohibited in @wsl2; use the approved toolchain." >&2
    ;;
esac
exit 2
