+describe('Layer 6 (A3) — Python decorated class', () => {
+  const source = `
+from dataclasses import dataclass
+
+@dataclass
+class Shell:
+    name: str
+
+    def __post_init__(self):
+        self.ready = True
+
+    def get_toolset(self):
+        return self.name
+`.trim();
+
+  test('unwraps a top-level decorator and emits class + method chunks', async () => {
+    const chunks = await chunkCodeText(source, 'src/shell.py');
+    const symbols = chunks.map(c => c.metadata.symbolName);
+    expect(symbols).toContain('Shell');
+    expect(symbols).toContain('__post_init__');
+    expect(symbols).toContain('get_toolset');
+
+    const method = chunks.find(c => c.metadata.symbolName === 'get_toolset');
+    expect(method!.metadata.parentSymbolPath).toEqual(['Shell']);
+  });
+});
