@@ -0,0 +1,67 @@
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+import { mkdtemp, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import {
+  __setEmbedTransportForTests,
+  configureGateway,
+  embed,
+  embedQuery,
+  resetGateway,
+} from '../src/core/ai/gateway.ts';
+import { __setVoyageUsagePathsForTests } from '../src/core/voyage-free-usage.ts';
+
+let transportCalls = 0;
+
+beforeEach(async () => {
+  transportCalls = 0;
+  resetGateway();
+  const dir = await mkdtemp(join(tmpdir(), 'gbrain-voyage-gateway-'));
+  const snapshotPath = join(dir, 'snapshot.json');
+  const ledgerPath = join(dir, 'usage.jsonl');
+  await writeFile(snapshotPath, JSON.stringify({
+    version: 1,
+    model: 'voyage-code-3',
+    source: 'dashboard',
+    totalFreeToken: 200_000_000,
+    usedTokenAtBaseline: 10_000_000,
+    baselineAt: '2026-06-01T00:00:00Z',
+    verifiedAt: '2026-06-01T00:00:00Z',
+    reauthDueAt: '2026-07-01T00:00:00Z',
+  }), 'utf-8');
+  __setVoyageUsagePathsForTests(snapshotPath, ledgerPath);
+  configureGateway({
+    embedding_model: 'voyage:voyage-code-3',
+    embedding_dimensions: 1024,
+    env: { VOYAGE_API_KEY: 'voy-test' },
+  });
+  __setEmbedTransportForTests(async ({ values }: any) => {
+    transportCalls++;
+    return { embeddings: values.map(() => new Array(1024).fill(0)), usage: { tokens: 0 } } as any;
+  });
+});
+
+afterEach(() => {
+  __setEmbedTransportForTests(null);
+  __setVoyageUsagePathsForTests(null, null);
+  resetGateway();
+});
+
+describe('voyage monthly reauthentication gateway fence', () => {
+  test('expired snapshot blocks document embedding before provider transport', async () => {
+    let error: Error | null = null;
+    try {
+      await embed(['document payload']);
+    } catch (e) {
+      error = e as Error;
+    }
+    expect(error?.message).toContain('reauthentication deadline');
+    expect(transportCalls).toBe(0);
+  });
+
+  test('expired snapshot still allows query embedding and records usage', async () => {
+    const vector = await embedQuery('query payload');
+    expect(vector.length).toBe(1024);
+    expect(transportCalls).toBe(1);
+  });
+});
diff --git a/test/voyage-free-usage.test.ts b/test/voyage-free-usage.test.ts
new file mode 100644
index 00000000..0f292f12
--- /dev/null
+++ b/test/voyage-free-usage.test.ts
@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, test } from 'bun:test';
+import { mkdtemp, readFile, writeFile } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import {
+  __setVoyageUsagePathsForTests,
+  getVoyageUsageStatus,
+  recordVoyageFreeEmbeddingUsage,
+  type VoyageUsageSnapshot,
+} from '../src/core/voyage-free-usage.ts';
+
+async function fixture(snapshot: VoyageUsageSnapshot) {
+  const dir = await mkdtemp(join(tmpdir(), 'gbrain-voyage-usage-'));
+  const snapshotPath = join(dir, 'snapshot.json');
+  const ledgerPath = join(dir, 'usage.jsonl');
+  await writeFile(snapshotPath, JSON.stringify(snapshot), 'utf-8');
+  __setVoyageUsagePathsForTests(snapshotPath, ledgerPath);
+  return { snapshotPath, ledgerPath };
+}
+
+const base: VoyageUsageSnapshot = {
+  version: 1,
+  model: 'voyage-code-3',
+  source: 'dashboard',
+  totalFreeToken: 200_000_000,
+  usedTokenAtBaseline: 100_000_000,
+  baselineAt: '2026-08-15T00:00:00Z',
+  verifiedAt: '2026-08-15T00:00:00Z',
+  reauthDueAt: '2026-09-14T00:00:00Z',
+};
+
+afterEach(() => __setVoyageUsagePathsForTests(null, null));
+
+describe('voyage free usage ledger', () => {
+  test('adds only post-baseline voyage-code-3 usage', async () => {
+    const { ledgerPath } = await fixture(base);
+    await writeFile(ledgerPath,
+      JSON.stringify({ ts: '2026-08-14T00:00:00Z', model: 'voyage-code-3', estimatedTokens: 999 }) + '\n' +
+      JSON.stringify({ ts: '2026-08-16T00:00:00Z', model: 'voyage-code-3', estimatedTokens: 1234 }) + '\n',
+      'utf-8');
+    const status = await getVoyageUsageStatus(new Date('2026-08-16T01:00:00Z'));
+    expect(status?.localEstimatedToken).toBe(1234);
+    expect(status?.usedToken).toBe(100_001_234);
+  });
+
+  test('80 percent is warning only', async () => {
+    await fixture({ ...base, usedTokenAtBaseline: 160_000_000 });
+    const status = await getVoyageUsageStatus(new Date('2026-08-16T00:00:00Z'));
+    expect(status?.warning).toBe(true);
+    expect(status?.reauthRequired).toBe(false);
+  });
+
+  test('30 days requires reauthentication', async () => {
+    await fixture(base);
+    const status = await getVoyageUsageStatus(new Date('2026-09-14T00:00:00Z'));
+    expect(status?.reauthRequired).toBe(true);
+  });
+
+  test('records successful voyage-code-3 calls but ignores other models', async () => {
+    const { ledgerPath } = await fixture(base);
+    await recordVoyageFreeEmbeddingUsage({
+      recipeId: 'voyage', modelId: 'voyage-code-3', estimatedTokens: 321, inputType: 'query',
+    });
+    await recordVoyageFreeEmbeddingUsage({
+      recipeId: 'voyage', modelId: 'voyage-4', estimatedTokens: 999, inputType: 'document',
+    });
+    const raw = await readFile(ledgerPath, 'utf-8');
+    expect(raw).toContain('"estimatedTokens":321');
+    expect(raw).not.toContain('"estimatedTokens":999');
+  });
+});
