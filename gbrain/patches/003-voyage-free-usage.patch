diff --git a/src/core/voyage-free-usage.ts b/src/core/voyage-free-usage.ts
new file mode 100644
index 00000000..484a9efc
--- /dev/null
+++ b/src/core/voyage-free-usage.ts
@@ -0,0 +1,156 @@
+import { appendFile, mkdir, readFile, writeFile } from 'node:fs/promises';
+import { homedir } from 'node:os';
+import { dirname, join } from 'node:path';
+
+export const VOYAGE_FREE_MODEL = 'voyage-code-3';
+export const VOYAGE_FREE_TOTAL_TOKENS = 200_000_000;
+export const VOYAGE_FREE_WARNING_PERCENT = 80;
+export const VOYAGE_REAUTH_MAX_AGE_DAYS = 30;
+
+export interface VoyageUsageSnapshot {
+  version: 1;
+  model: string;
+  source: 'dashboard' | 'local-bootstrap';
+  totalFreeToken: number;
+  usedTokenAtBaseline: number;
+  baselineAt: string;
+  verifiedAt: string | null;
+  reauthDueAt: string;
+}
+
+export interface VoyageUsageStatus {
+  snapshot: VoyageUsageSnapshot;
+  localEstimatedToken: number;
+  usedToken: number;
+  remainingToken: number;
+  usedPercent: number;
+  warning: boolean;
+  reauthRequired: boolean;
+}
+
+let _snapshotPathOverride: string | null = null;
+let _ledgerPathOverride: string | null = null;
+let _warnedThisProcess = false;
+
+function stateRoot(): string {
+  const xdg = process.env.XDG_STATE_HOME?.trim();
+  return xdg || join(homedir(), '.local', 'state');
+}
+
+export function voyageUsageSnapshotPath(): string {
+  return _snapshotPathOverride ?? join(stateRoot(), 'gbrain', 'voyage', 'free-usage-snapshot.json');
+}
+
+export function voyageUsageLedgerPath(): string {
+  return _ledgerPathOverride ?? join(stateRoot(), 'gbrain', 'voyage', 'free-usage.jsonl');
+}
+
+/** @internal test seam */
+export function __setVoyageUsagePathsForTests(snapshot: string | null, ledger: string | null): void {
+  _snapshotPathOverride = snapshot;
+  _ledgerPathOverride = ledger;
+  _warnedThisProcess = false;
+}
+
+export async function readVoyageUsageSnapshot(): Promise<VoyageUsageSnapshot | null> {
+  try {
+    const raw = JSON.parse(await readFile(voyageUsageSnapshotPath(), 'utf-8')) as VoyageUsageSnapshot;
+    if (
+      raw?.version !== 1 || raw.model !== VOYAGE_FREE_MODEL ||
+      !Number.isInteger(raw.totalFreeToken) || raw.totalFreeToken <= 0 ||
+      !Number.isInteger(raw.usedTokenAtBaseline) || raw.usedTokenAtBaseline < 0 ||
+      typeof raw.baselineAt !== 'string' || typeof raw.reauthDueAt !== 'string'
+    ) return null;
+    return raw;
+  } catch {
+    return null;
+  }
+}
+
+async function readLedgerTokensAfter(baselineAt: string): Promise<number> {
+  let text: string;
+  try {
+    text = await readFile(voyageUsageLedgerPath(), 'utf-8');
+  } catch {
+    return 0;
+  }
+  const cutoff = Date.parse(baselineAt);
+  let total = 0;
+  for (const line of text.split('\n')) {
+    if (!line.trim()) continue;
+    try {
+      const row = JSON.parse(line) as { ts?: unknown; model?: unknown; estimatedTokens?: unknown };
+      if (row.model !== VOYAGE_FREE_MODEL || typeof row.ts !== 'string') continue;
+      const ts = Date.parse(row.ts);
+      if (!Number.isFinite(ts) || ts <= cutoff) continue;
+      if (!Number.isInteger(row.estimatedTokens) || (row.estimatedTokens as number) <= 0) continue;
+      total += row.estimatedTokens as number;
+    } catch {
+      // Torn/malformed observability row: ignore it rather than breaking embedding.
+    }
+  }
+  return total;
+}
+
+export async function getVoyageUsageStatus(now: Date = new Date()): Promise<VoyageUsageStatus | null> {
+  const snapshot = await readVoyageUsageSnapshot();
+  if (!snapshot) return null;
+  const localEstimatedToken = await readLedgerTokensAfter(snapshot.baselineAt);
+  const usedToken = Math.max(0, snapshot.usedTokenAtBaseline + localEstimatedToken);
+  const remainingToken = Math.max(0, snapshot.totalFreeToken - usedToken);
+  const usedPercent = (usedToken / snapshot.totalFreeToken) * 100;
+  const due = Date.parse(snapshot.reauthDueAt);
+  return {
+    snapshot,
+    localEstimatedToken,
+    usedToken,
+    remainingToken,
+    usedPercent,
+    warning: usedPercent >= VOYAGE_FREE_WARNING_PERCENT,
+    reauthRequired: !Number.isFinite(due) || now.getTime() >= due,
+  };
+}
+
+/**
+ * Record one SUCCESSFUL Voyage voyage-code-3 HTTP sub-batch.
+ * The recipe deliberately uses 1 char ~= 1 token for mixed code/JSON/CJK, so
+ * this is conservative between monthly authoritative dashboard refreshes.
+ * Never throws: accounting must not turn a successful provider call into a failure.
+ */
+export async function recordVoyageFreeEmbeddingUsage(args: {
+  recipeId: string;
+  modelId: string;
+  estimatedTokens: number;
+  inputType: 'query' | 'document';
+}): Promise<void> {
+  if (args.recipeId !== 'voyage' || args.modelId !== VOYAGE_FREE_MODEL) return;
+  if (!Number.isInteger(args.estimatedTokens) || args.estimatedTokens <= 0) return;
+  try {
+    const path = voyageUsageLedgerPath();
+    await mkdir(dirname(path), { recursive: true });
+    await appendFile(path, JSON.stringify({
+      ts: new Date().toISOString(),
+      model: args.modelId,
+      estimatedTokens: args.estimatedTokens,
+      inputType: args.inputType,
+    }) + '\n', 'utf-8');
+
+    const status = await getVoyageUsageStatus();
+    if (status?.warning && !_warnedThisProcess) {
+      _warnedThisProcess = true;
+      console.error(
+        `[voyage-usage] WARNING: estimated ${status.usedPercent.toFixed(1)}% of ${status.snapshot.totalFreeToken.toLocaleString()} free ${VOYAGE_FREE_MODEL} tokens used; ` +
+        `reauth by ${status.snapshot.reauthDueAt} to reset from fresh Voyage usage.`,
+      );
+    }
+  } catch {
+    // Local accounting is observability/safety guidance; provider success wins.
+  }
+}
+
+/** Write/replace the authoritative or migration baseline atomically enough for a tiny local state file. */
+export async function writeVoyageUsageSnapshot(snapshot: VoyageUsageSnapshot): Promise<void> {
+  const path = voyageUsageSnapshotPath();
+  await mkdir(dirname(path), { recursive: true });
+  await writeFile(path, JSON.stringify(snapshot, null, 2) + '\n', 'utf-8');
+}
