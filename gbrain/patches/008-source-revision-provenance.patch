From 8f227b22a37c219f2e52b734b4dc5cc0bcbfafb7 Mon Sep 17 00:00:00 2001
From: nicezic <nicezic@gmail.com>
Date: Tue, 18 Aug 2026 15:50:29 +0900
Subject: [PATCH] feat: capture source revision provenance

---
 src/core/eval-capture.ts  | 5 +++++
 src/core/types.ts         | 2 ++
 test/eval-capture.test.ts | 3 +++
 3 files changed, 10 insertions(+)

diff --git a/src/core/eval-capture.ts b/src/core/eval-capture.ts
index 66996a87..22faca1e 100644
--- a/src/core/eval-capture.ts
+++ b/src/core/eval-capture.ts
@@ -174,6 +174,10 @@ export async function buildSchemaPackPerSourceSnapshot(
 
   const snapshot: NonNullable<EvalCandidateInput['schema_pack_per_source']> = {};
   for (const sourceId of ids) {
+    const sourceRows = await engine.executeRaw<{ last_commit: string | null }>(
+      `SELECT last_commit FROM sources WHERE id = $1`,
+      [sourceId],
+    );
     const pack = await loadActivePack({
       cfg: config,
       remote,
@@ -190,6 +194,7 @@ export async function buildSchemaPackPerSourceSnapshot(
       pack_version: pack.manifest.version,
       manifest_sha8: pack.manifest_sha8,
       alias_closure_resolved: aliasClosureResolved,
+      source_commit: sourceRows[0]?.last_commit ?? null,
     };
   }
   return snapshot;
diff --git a/src/core/types.ts b/src/core/types.ts
index 84c43ca2..431de0fe 100644
--- a/src/core/types.ts
+++ b/src/core/types.ts
@@ -1693,6 +1693,8 @@ export interface EvalCandidateInput {
       pack_version: string;
       manifest_sha8: string;
       alias_closure_resolved: Record<string, string[]>;
+      /** Source repo revision at capture time. Informational lineage; exact evidence bytes use retrieved_chunk_hashes. */
+      source_commit?: string | null;
     }
   > | null;
 }
diff --git a/test/eval-capture.test.ts b/test/eval-capture.test.ts
index 3415b338..532df5b6 100644
--- a/test/eval-capture.test.ts
+++ b/test/eval-capture.test.ts
@@ -163,6 +163,7 @@ describe('schema-pack capture provenance', () => {
     delete process.env.GBRAIN_SCHEMA_PACK;
     const engine = {
       getConfig: async () => null,
+      executeRaw: async () => [{ last_commit: 'abc123def456' }],
     } as unknown as BrainEngine;
     try {
       const snapshot = await buildSchemaPackPerSourceSnapshot(
@@ -177,6 +178,7 @@ describe('schema-pack capture provenance', () => {
       expect(entry!.pack_name).toBe('gbrain-base');
       expect(entry!.pack_version.length).toBeGreaterThan(0);
       expect(entry!.manifest_sha8).toMatch(/^[0-9a-f]{8}$/);
+      expect(entry!.source_commit).toBe('abc123def456');
       expect(Object.keys(entry!.alias_closure_resolved).length).toBeGreaterThan(0);
       for (const [typeName, closure] of Object.entries(entry!.alias_closure_resolved)) {
         expect(closure).toContain(typeName);
@@ -218,6 +220,7 @@ describe('captureEvalCandidate — best-effort failure handling', () => {
     return {
       logEvalCandidate: mock(() => Promise.resolve(1)),
       logEvalCaptureFailure: mock(() => Promise.resolve()),
+      executeRaw: mock(() => Promise.resolve([{ last_commit: null }])),
       ...overrides,
     } as unknown as BrainEngine;
   }
-- 
