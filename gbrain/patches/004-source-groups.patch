--- /dev/null
+++ b/src/core/source-groups.ts
@@ -0,0 +1,70 @@
+import type { BrainEngine } from './engine.ts';
+import { SOURCE_ID_RE, assertValidSourceId } from './source-id.ts';
+
+const GROUP_PREFIX = 'sources.groups.';
+
+function assertValidGroupName(name: unknown): asserts name is string {
+  if (typeof name !== 'string' || !SOURCE_ID_RE.test(name)) {
+    throw new Error(
+      `Invalid source group name: ${JSON.stringify(name)}. ` +
+      'Must be 1-32 lowercase alnum chars with optional interior hyphens.',
+    );
+  }
+}
+
+export function sourceGroupConfigKey(name: string): string {
+  assertValidGroupName(name);
+  return `${GROUP_PREFIX}${name}`;
+}
+
+async function validateGroupSources(engine: BrainEngine, sourceIds: string[]): Promise<string[]> {
+  if (sourceIds.length === 0) throw new Error('A source group must contain at least one source.');
+  const deduped = [...new Set(sourceIds)];
+  for (const id of deduped) assertValidSourceId(id);
+
+  const rows = await engine.executeRaw<{ id: string; archived: boolean }>(
+    `SELECT id, archived FROM sources WHERE id = ANY($1::text[])`,
+    [deduped],
+  );
+  const byId = new Map(rows.map((r) => [r.id, r]));
+  const missing = deduped.filter((id) => !byId.has(id));
+  if (missing.length > 0) throw new Error(`Unknown source(s) in group: ${missing.join(', ')}`);
+  const archived = deduped.filter((id) => byId.get(id)?.archived === true);
+  if (archived.length > 0) throw new Error(`Archived source(s) cannot be used in a group: ${archived.join(', ')}`);
+  return deduped;
+}
+
+export async function setSourceGroup(engine: BrainEngine, name: string, sourceIds: string[]): Promise<string[]> {
+  const key = sourceGroupConfigKey(name);
+  const validated = await validateGroupSources(engine, sourceIds);
+  await engine.setConfig(key, JSON.stringify(validated));
+  return validated;
+}
+
+export async function getSourceGroup(engine: BrainEngine, name: string): Promise<string[]> {
+  const key = sourceGroupConfigKey(name);
+  const raw = await engine.getConfig(key);
+  if (!raw) throw new Error(`Source group "${name}" not found.`);
+  let parsed: unknown;
+  try { parsed = JSON.parse(raw); } catch {
+    throw new Error(`Source group "${name}" has invalid JSON config.`);
+  }
+  if (!Array.isArray(parsed) || parsed.some((v) => typeof v !== 'string')) {
+    throw new Error(`Source group "${name}" must be a JSON array of source IDs.`);
+  }
+  return validateGroupSources(engine, parsed as string[]);
+}
+
+export async function listSourceGroups(engine: BrainEngine): Promise<Array<{ name: string; sourceIds: string[] }>> {
+  const keys = (await engine.listConfigKeys(GROUP_PREFIX)).sort();
+  const out: Array<{ name: string; sourceIds: string[] }> = [];
+  for (const key of keys) {
+    const name = key.slice(GROUP_PREFIX.length);
+    out.push({ name, sourceIds: await getSourceGroup(engine, name) });
+  }
+  return out;
+}
+
+export async function removeSourceGroup(engine: BrainEngine, name: string): Promise<number> {
+  return engine.unsetConfig(sourceGroupConfigKey(name));
+}
