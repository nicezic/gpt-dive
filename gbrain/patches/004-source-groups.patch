+// ── Subcommand: group ───────────────────────────────────────
+
+async function runGroup(engine: BrainEngine, args: string[]): Promise<void> {
+  const action = args[0];
+  const rest = args.slice(1);
+  const json = rest.includes('--json');
+  const clean = rest.filter((a) => a !== '--json');
+
+  if (!action || action === '--help' || action === '-h') {
+    console.log(`Usage: gbrain sources group <set|show|list|remove> ...
+
+  set <name> <source...>   Create or replace a named source group.
+  show <name> [--json]     Show one group.
+  list [--json]            List all groups.
+  remove <name>            Delete a group definition only; sources/data stay intact.`);
+    return;
+  }
+
+  if (action === 'set') {
+    const [name, ...sourceIds] = clean;
+    if (!name || sourceIds.length === 0) {
+      console.error('Usage: gbrain sources group set <name> <source...>');
+      process.exit(2);
+    }
+    const stored = await setSourceGroup(engine, name, sourceIds);
+    console.log(`Source group "${name}" = [${stored.join(', ')}]`);
+    return;
+  }
+
+  if (action === 'show') {
+    const name = clean[0];
+    if (!name) {
+      console.error('Usage: gbrain sources group show <name> [--json]');
+      process.exit(2);
+    }
+    const sourceIds = await getSourceGroup(engine, name);
+    if (json) console.log(JSON.stringify({ name, source_ids: sourceIds }, null, 2));
+    else console.log(`${name}: ${sourceIds.join(', ')}`);
+    return;
+  }
+
+  if (action === 'list') {
+    const groups = await listSourceGroups(engine);
+    if (json) {
+      console.log(JSON.stringify({ groups: groups.map((g) => ({ name: g.name, source_ids: g.sourceIds })) }, null, 2));
+      return;
+    }
+    if (groups.length === 0) {
+      console.log('No source groups configured.');
+      return;
+    }
+    for (const g of groups) console.log(`${g.name}: ${g.sourceIds.join(', ')}`);
+    return;
+  }
+
+  if (action === 'remove') {
+    const name = clean[0];
+    if (!name) {
+      console.error('Usage: gbrain sources group remove <name>');
+      process.exit(2);
+    }
+    const n = await removeSourceGroup(engine, name);
+    if (n === 0) {
+      console.error(`Source group "${name}" not found.`);
+      process.exit(4);
+    }
+    console.log(`Removed source group "${name}". Sources and embeddings were not changed.`);
+    return;
+  }
+
+  console.error(`Unknown sources group action: ${action}`);
+  process.exit(2);
+}
