+import { describe, expect, test } from 'bun:test';
+import type { BrainEngine } from '../src/core/engine.ts';
+import {
+  getSourceGroup,
+  listSourceGroups,
+  removeSourceGroup,
+  setSourceGroup,
+} from '../src/core/source-groups.ts';
+import { operationsByName } from '../src/core/operations.ts';
+
+function fakeEngine(opts: { archived?: string[] } = {}) {
+  const config = new Map<string, string>();
+  const sources = new Map([
+    ['pydantic-ai', { id: 'pydantic-ai', archived: false }],
+    ['pydantic-ai-harness', { id: 'pydantic-ai-harness', archived: false }],
+    ['old-source', { id: 'old-source', archived: true }],
+  ]);
+  for (const id of opts.archived ?? []) {
+    const row = sources.get(id);
+    if (row) row.archived = true;
+  }
+  const searchScopes: Array<{ sourceId?: string; sourceIds?: string[]; limit?: number; offset?: number }> = [];
+  const engine = {
+    getConfig: async (key: string) => config.get(key) ?? null,
+    setConfig: async (key: string, value: string) => { config.set(key, value); },
+    unsetConfig: async (key: string) => config.delete(key) ? 1 : 0,
+    listConfigKeys: async (prefix: string) => [...config.keys()].filter((k) => k.startsWith(prefix)),
+    executeRaw: async <T>(_sql: string, params?: unknown[]): Promise<T[]> => {
+      const ids = (params?.[0] as string[] | undefined) ?? [];
+      return ids.map((id) => sources.get(id)).filter(Boolean) as T[];
+    },
+    searchKeyword: async (_q: string, scope: { sourceId?: string; sourceIds?: string[]; limit?: number; offset?: number }) => {
+      searchScopes.push(scope);
+      return [];
+    },
+  } as unknown as BrainEngine;
+  return { engine, config, searchScopes };
+}
+
+describe('named source groups', () => {
+  test('set/get/list/remove preserves an ordered deduplicated source list', async () => {
+    const { engine } = fakeEngine();
+    expect(await setSourceGroup(engine, 'pydantic', ['pydantic-ai', 'pydantic-ai-harness', 'pydantic-ai'])).toEqual([
+      'pydantic-ai',
+      'pydantic-ai-harness',
+    ]);
+    expect(await getSourceGroup(engine, 'pydantic')).toEqual(['pydantic-ai', 'pydantic-ai-harness']);
+    expect(await listSourceGroups(engine)).toEqual([{
+      name: 'pydantic',
+      sourceIds: ['pydantic-ai', 'pydantic-ai-harness'],
+    }]);
+    expect(await removeSourceGroup(engine, 'pydantic')).toBe(1);
+    expect(await removeSourceGroup(engine, 'pydantic')).toBe(0);
+  });
+
+  test('rejects unknown and archived members', async () => {
+    const { engine } = fakeEngine();
+    await expect(setSourceGroup(engine, 'pydantic', ['missing'])).rejects.toThrow('Unknown source');
+    await expect(setSourceGroup(engine, 'pydantic', ['old-source'])).rejects.toThrow('Archived source');
+  });
+
+  test('search resolves --source-group to sourceIds[] without rewriting sources', async () => {
+    const { engine, searchScopes } = fakeEngine();
+    await setSourceGroup(engine, 'pydantic', ['pydantic-ai', 'pydantic-ai-harness']);
+    await engine.setConfig('search.mcp_keyword_only', 'true');
+    const op = operationsByName.search;
+    await op.handler({
+      engine,
+      config: { engine: 'pglite' },
+      logger: { info: () => {}, warn: () => {}, error: () => {} },
+      dryRun: false,
+      remote: false,
+      sourceId: 'default',
+      brainId: 'host',
+    }, { query: 'ToolOutputLimits', source_group: 'pydantic' });
+    expect(searchScopes).toEqual([{
+      limit: 20,
+      offset: 0,
+      sourceIds: ['pydantic-ai', 'pydantic-ai-harness'],
+    }]);
+  });
+
+  test('configured search.source_group applies to unqualified local search', async () => {
+    const { engine, searchScopes } = fakeEngine();
+    await setSourceGroup(engine, 'pydantic', ['pydantic-ai', 'pydantic-ai-harness']);
+    await engine.setConfig('search.source_group', 'pydantic');
+    await engine.setConfig('search.mcp_keyword_only', 'true');
+    await operationsByName.search.handler({
+      engine,
+      config: { engine: 'pglite' },
+      logger: { info: () => {}, warn: () => {}, error: () => {} },
+      dryRun: false,
+      remote: false,
+      sourceId: 'default',
+      brainId: 'host',
+    }, { query: 'ToolOutputLimits' });
+    expect(searchScopes).toEqual([{
+      limit: 20,
+      offset: 0,
+      sourceIds: ['pydantic-ai', 'pydantic-ai-harness'],
+    }]);
+  });
+
+  test('explicit source scope overrides configured default group', async () => {
+    const { engine, searchScopes } = fakeEngine();
+    await setSourceGroup(engine, 'pydantic', ['pydantic-ai', 'pydantic-ai-harness']);
+    await engine.setConfig('search.source_group', 'pydantic');
+    await engine.setConfig('search.mcp_keyword_only', 'true');
+    await operationsByName.search.handler({
+      engine,
+      config: { engine: 'pglite' },
+      logger: { info: () => {}, warn: () => {}, error: () => {} },
+      dryRun: false,
+      remote: false,
+      sourceId: 'pydantic-ai',
+      brainId: 'host',
+    }, { query: 'Agent.run', source: 'pydantic-ai' });
+    expect(searchScopes).toEqual([{
+      limit: 20,
+      offset: 0,
+      sourceId: 'pydantic-ai',
+    }]);
+  });
+
+  test('ambient explicit source marker overrides configured default group', async () => {
+    const { engine, searchScopes } = fakeEngine();
+    await setSourceGroup(engine, 'pydantic', ['pydantic-ai', 'pydantic-ai-harness']);
+    await engine.setConfig('search.source_group', 'pydantic');
+    await engine.setConfig('search.mcp_keyword_only', 'true');
+    await operationsByName.search.handler({
+      engine,
+      config: { engine: 'pglite' },
+      logger: { info: () => {}, warn: () => {}, error: () => {} },
+      dryRun: false,
+      remote: false,
+      sourceId: 'pydantic-ai-harness',
+      brainId: 'host',
+      localSourceExplicit: true,
+    }, { query: 'ToolOutputLimits' });
+    expect(searchScopes).toEqual([{
+      limit: 20,
+      offset: 0,
+      sourceId: 'pydantic-ai-harness',
+    }]);
+  });
+
+  test('source_group is local-only and mutually exclusive with explicit source scope', async () => {
+    const { engine } = fakeEngine();
