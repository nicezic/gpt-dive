+/** Resolve an explicit/default named source group for trusted local search/query calls. */
+export async function resolveNamedSearchGroupScope(
+  ctx: OperationContext,
+  rawGroup: unknown,
+  hasExplicitSourceScope: boolean,
+): Promise<{ sourceIds: string[] } | null> {
+  const explicitGroup = typeof rawGroup === 'string' && rawGroup.length > 0 ? rawGroup : undefined;
+  if (explicitGroup) {
+    if (ctx.remote !== false) {
+      throw new OperationError('invalid_params', 'source_group is available only to trusted local callers.');
+    }
+    if (hasExplicitSourceScope) {
+      throw new OperationError('invalid_params', 'Pass source_group or an explicit source scope, not both.');
+    }
+    return { sourceIds: await getSourceGroup(ctx.engine, explicitGroup) };
+  }
+
+  if (hasExplicitSourceScope || ctx.remote !== false || ctx.localSourceExplicit === true) return null;
+  const configured = (await ctx.engine.getConfig('search.source_group'))?.trim();
+  if (!configured) return null;
+  return { sourceIds: await getSourceGroup(ctx.engine, configured) };
+}
