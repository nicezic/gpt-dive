   expand_enabled: boolean | null;
   /** The `detail` flag as requested (query-only). */
@@ -131,6 +133,59 @@ export function buildEvalCandidateInput(
  * Narrow by Postgres SQLSTATE where we can (postgres-js + PGLite both
  * surface `.code`), fall back to 'other'.
  */
+export async function buildSchemaPackPerSourceSnapshot(
+  engine: BrainEngine,
+  sourceIds: string[],
+  remote: boolean,
+  config: GBrainConfig | null,
+): Promise<NonNullable<EvalCandidateInput['schema_pack_per_source']> | null> {
+  const ids = [...new Set(sourceIds)].sort();
+  if (ids.length === 0) return null;
+
+  const { loadActivePack } = await import('./schema-pack/load-active.ts');
+  const { expandClosure } = await import('./schema-pack/closure.ts');
+
+  let dbConfig: string | undefined;
+  try {
+    dbConfig = (await engine.getConfig('schema_pack'))?.trim() || undefined;
+  } catch {
+    dbConfig = undefined;
+  }
+
+  const perSourceDb = new Map<string, string>();
+  for (const sourceId of ids) {
+    try {
+      const value = (await engine.getConfig(`schema_pack.source.${sourceId}`))?.trim();
+      if (value) perSourceDb.set(sourceId, value);
+    } catch {
+      // Missing config rows are normal; pack resolution falls through to the
+      // remaining canonical precedence tiers.
+    }
+  }
+
+  const snapshot: NonNullable<EvalCandidateInput['schema_pack_per_source']> = {};
+  for (const sourceId of ids) {
+    const pack = await loadActivePack({
+      cfg: config,
+      remote,
+      sourceId,
+      perSourceDb,
+      dbConfig,
+    });
+    const aliasClosureResolved: Record<string, string[]> = {};
+    for (const typeName of pack.manifest.page_types.map((t) => t.name).sort()) {
+      aliasClosureResolved[typeName] = expandClosure(typeName, pack.alias_graph);
+    }
+    snapshot[sourceId] = {
+      pack_name: pack.manifest.name,
+      pack_version: pack.manifest.version,
+      manifest_sha8: pack.manifest_sha8,
+      alias_closure_resolved: aliasClosureResolved,
+    };
+  }
+  return snapshot;
+}
+
 export function classifyCaptureFailure(err: unknown): EvalCaptureFailureReason {
   if (err && typeof err === 'object') {
     const code = (err as { code?: string }).code;
@@ -176,6 +231,12 @@ async function doCaptureEvalCandidate(
 ): Promise<void> {
   try {
     const input = buildEvalCandidateInput(ctx, opts);
+    input.schema_pack_per_source = await buildSchemaPackPerSourceSnapshot(
+      engine,
+      input.source_ids,
+      ctx.remote,
+      ctx.config ?? null,
+    );
     await engine.logEvalCandidate(input);
   } catch (err) {
     const reason = classifyCaptureFailure(err);
