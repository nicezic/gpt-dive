   isEvalCaptureEnabled,
@@ -137,6 +138,38 @@ describe('buildEvalCandidateInput', () => {
   });
 });
 
+describe('schema-pack capture provenance', () => {
+  test('captures canonical per-source pack identity and resolved alias closure', async () => {
+    const prior = process.env.GBRAIN_SCHEMA_PACK;
+    delete process.env.GBRAIN_SCHEMA_PACK;
+    const engine = {
+      getConfig: async () => null,
+    } as unknown as BrainEngine;
+    try {
+      const snapshot = await buildSchemaPackPerSourceSnapshot(
+        engine,
+        ['pydantic-ai'],
+        false,
+        { engine: 'pglite', schema_pack: 'gbrain-base' },
+      );
+      expect(snapshot).not.toBeNull();
+      const entry = snapshot!['pydantic-ai'];
+      expect(entry).toBeDefined();
+      expect(entry!.pack_name).toBe('gbrain-base');
+      expect(entry!.pack_version.length).toBeGreaterThan(0);
+      expect(entry!.manifest_sha8).toMatch(/^[0-9a-f]{8}$/);
+      expect(Object.keys(entry!.alias_closure_resolved).length).toBeGreaterThan(0);
+      for (const [typeName, closure] of Object.entries(entry!.alias_closure_resolved)) {
+        expect(closure).toContain(typeName);
+        expect(closure).toEqual([...closure].sort());
+      }
+    } finally {
+      if (prior === undefined) delete process.env.GBRAIN_SCHEMA_PACK;
+      else process.env.GBRAIN_SCHEMA_PACK = prior;
+    }
+  });
+});
+
 describe('classifyCaptureFailure', () => {
   test('maps Postgres 23514 to check_violation', () => {
     expect(classifyCaptureFailure({ code: '23514' })).toBe('check_violation');
