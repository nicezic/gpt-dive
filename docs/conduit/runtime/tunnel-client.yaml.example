# Conduit tunnel-client profile template.
# Runtime copy: ~/.config/tunnel-client/conduit.yaml
# Secrets stay outside the repo.
config_version: 1
control_plane:
  base_url: "https://api.openai.com"
  tunnel_id: "<CONDUIT_TUNNEL_ID>"
  api_key: "env:CONTROL_PLANE_API_KEY"
health:
  unix_socket: "/home/nicezic/.local/run/gpt-dive/tunnel-conduit.sock"
admin_ui:
  open_browser: false
log:
  level: info
  format: json
mcp:
  commands:
    - channel: main
      command: "/home/nicezic/gpt-dive/.venv/bin/python -m gpt_dive.conduit"
